// 1. Validate candle data
export function validateCandle(c) {
  if (!c || typeof c !== "object") return false;

  const values = [
    c.open,
    c.high,
    c.low,
    c.close,
    c.volume
  ];

  if (!values.every(Number.isFinite)) {
    return false;
  }

  return (
    c.high >= Math.max(c.open, c.close) &&
    c.low <= Math.min(c.open, c.close) &&
    c.high >= c.low &&
    c.volume >= 0
  );
}

// 2. Analyze candle structure
export function analyzeCandle(c) {
  if (!validateCandle(c)) {
    throw new Error("Invalid candle data");
  }

  const body = Math.abs(c.close - c.open);
  const range = c.high - c.low;

  const upperWick =
    c.high - Math.max(c.open, c.close);

  const lowerWick =
    Math.min(c.open, c.close) - c.low;

  return {
    direction:
      c.close > c.open ? "BULLISH" :
      c.close < c.open ? "BEARISH" :
      "NEUTRAL",

    body: body,
    range: range,

    upperWick: upperWick,
    lowerWick: lowerWick,

    bodyRatio: range ? body / range : 0,
    upperWickRatio: range ? upperWick / range : 0,
    lowerWickRatio: range ? lowerWick / range : 0,

    strength:
      range === 0 ? "NO RANGE" :
      body / range >= 0.7 ? "STRONG BODY" :
      body / range >= 0.4 ? "MODERATE BODY" :
      "SMALL BODY"
  };
}

// 3. Analyze multiple candles
export function analyzeCandles(candles) {
  if (!Array.isArray(candles)) {
    throw new Error("Candles must be an array");
  }

  return candles.map((c, index) => ({
    candleNumber: index + 1,
    ...analyzeCandle(c)
  }));
}

// 4. Test candle
export function testCandleCore() {
  const sample = {
    open: 100,
    high: 110,
    low: 95,
    close: 108,
    volume: 500
  };

  return analyzeCandle(sample);
}
